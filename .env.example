# Base URL prefixed to every API call. Leave empty to call the same origin
# (dev: the Vite proxy; prod: the ingress that also serves this app).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /<service>/api/* (dev only).
VITE_PROXY_TARGET=

# Path prefix per service at the ingress (DEMO-PATH D-05). Change these if the
# gateway mounts a service elsewhere.
VITE_AUTH_PREFIX=/auth
VITE_BILLING_PREFIX=/billing
VITE_FLOW_PREFIX=/flow
VITE_TELEPHONY_PREFIX=/telephony
VITE_INBOUND_PREFIX=/inbound
VITE_OUTBOUND_PREFIX=/outbound
VITE_ANALYTICS_PREFIX=/analytics
VITE_INTEGRATION_PREFIX=/integration
